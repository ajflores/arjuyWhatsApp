<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>arjuywhatsapp-sample-wpf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArjuyWhatsApp\ArjuyWhatsApp.csproj" />
  </ItemGroup>

  <!--
    Igual mecanismo que usa ArjuyWhatsApp/ArjuyWhatsApp.csproj: FrameworkReference (no
    PackageReference) al shared framework ASP.NET Core. Este proyecto es Microsoft.NET.Sdk +
    UseWPF (NO Microsoft.NET.Sdk.Web), pero igual necesita WebApplication.CreateBuilder, Kestrel,
    MapArjuyWhatsAppWebhook, etc. para el mini-host HTTP embebido de App.xaml.cs — ver el
    comentario al principio de ese archivo para el porqué completo.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
