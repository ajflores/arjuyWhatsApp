<Application x:Class="ArjuyWhatsApp.Sample.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Sin StartupUri a propósito: StartupUri crea la MainWindow con su constructor sin
        parámetros ANTES de que App.xaml.cs pueda levantar el host embebido y resolver
        IArjuyWhatsAppClient. En vez de eso, App.xaml.cs override-a OnStartup, arma el host,
        y recién ahí construye y muestra la MainWindow pasándole el cliente por constructor.
    -->
    <Application.Resources />
</Application>
